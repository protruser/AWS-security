# ─────────────────────────────────────────────────────────────────────────────
# 로그인
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_ROLE=관리자
ADMIN_TEAM=보안관제팀

# Flask 세션 쿠키 서명용. 운영에서는 반드시 충분히 긴 랜덤 문자열로 변경하세요.
FLASK_SECRET_KEY=change-this-to-a-long-random-secret
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI 보안 분석 챗봇
# API 키는 React 코드가 아니라 반드시 서버 .env에만 저장합니다.
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=700

# ─────────────────────────────────────────────────────────────────────────────
# MySQL
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=security_app
DB_PASSWORD=change-me
DB_NAME=security

# 운영 EC2에서는 DB_SECRET_ID를 설정하면 Secrets Manager 값을 우선 사용합니다.
# Terraform 기본 이름: wonny-sec/security-db
# DB_SECRET_ID=wonny-sec/security-db
AWS_REGION=ap-northeast-2

# React 개발 서버가 Flask를 직접 호출할 경우 허용 Origin
CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://localhost:3000

# 승인된 조치를 실행하는 Lambda 이름 (Terraform: <project>-remediation)
REMEDIATION_FUNCTION_NAME=wonny-sec-remediation
